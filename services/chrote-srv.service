[Unit]
Description=CHROTE /srv proving service
After=network.target

[Service]
Type=simple
User=chrote
Group=chrote
EnvironmentFile=/etc/chrote/chrote-srv.env
RuntimeDirectory=chrote
RuntimeDirectoryMode=0750
StateDirectory=chrote
StateDirectoryMode=0750
# The service account's passwd home is the source checkout it serves from, so
# every XDG-aware tool the server invokes -- bd above all -- deposits
# service-owned config and cache inside that checkout, mode 0600 and unreadable
# to the repository owner. These come after the EnvironmentFile on purpose: the
# home the service writes into is the unit's decision, not a host override.
Environment=HOME=/var/lib/chrote
Environment=XDG_CONFIG_HOME=/var/lib/chrote/config
Environment=XDG_CACHE_HOME=/var/lib/chrote/cache
Environment=XDG_STATE_HOME=/var/lib/chrote/state
UMask=0002
ExecStartPre=+/bin/sh -lc 'install -d -o "${CHROTE_SERVICE_USER:-chrote}" -g "${CHROTE_SERVICE_GROUP:-chrote}" -m "${CHROTE_RUNTIME_MODE:-0750}" "${CHROTE_RUNTIME_ROOT:-/run/chrote}/tmux"'
ExecStart=/bin/sh -lc 'cd "$CHROTE_SERVICE_ROOT" && exec "$CHROTE_SERVICE_ROOT/chrote-server" --host "${HOST:-127.0.0.1}" --port "${PORT:-8095}"'
# KillMode=process is ruled on by docs/adr/0013-ttyd-restart-lifecycle-and-orphan-reaping.md,
# as amended by docs/adr/0018-terminal-transport-ownership.md, which own the
# lifecycle and reaping story. Read those before changing this line.
#
# Two measurements worth keeping next to the setting, because both invite wrong
# conclusions from `systemctl status` alone:
#
#   Browser terminals are not what this protects. Each attach runs on a
#   pseudo-terminal this process owns, so it is hung up the moment the process
#   exits, whatever KillMode says.
#
#   Sessions surviving a restart are NOT evidence that this setting works. The
#   tmux servers holding them are owned by other users and sit outside this
#   cgroup, so they survive either setting. Only an in-cgroup tmux server would
#   demonstrate anything, and per ADR-0013 that case is still open.
#
# The cost is orphans: `systemctl stop` leaves any in-cgroup child running. Keep it
# in the tracked unit so reinstalling from the repo cannot silently revert it, the
# way the legacy lane's drop-in-only setting could.
KillMode=process
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
