[Unit]
Description=CHROTE persistent workspace cockpit
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/chrote
ExecStartPre=/usr/bin/mkdir -p %t/chrote-tmux
ExecStart=%h/chrote/chrote-server --host 127.0.0.1 --port 8094 --ttyd-port 7683
Restart=on-failure
RestartSec=5
Environment=PORT=8094
Environment=TTYD_PORT=7683
Environment=TMUX_TMPDIR=%t/chrote-tmux
Environment=CHROTE_WORKDIR=%h
Environment=CHROTE_ROOTS=%h
Environment=CHROTE_BEADS_WORKSPACES=%h
Environment=CHROTE_LAUNCH_SCRIPT=%h/chrote/terminal-launch.sh
Environment=CHROTE_GASCITY_CITY_DIR=%h/gascity
Environment=CHROTE_BD_COMMAND=bd
Environment=CHROTE_TTS_URL=http://127.0.0.1:3100
Environment=CHROTE_CONTEXT_API_URL=http://127.0.0.1:3200
EnvironmentFile=-%h/.config/chrote/services.env
Environment=PATH=%h/.local/bin:/usr/local/go/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=default.target
