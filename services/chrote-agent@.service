[Unit]
Description=CHROTE locked agent %i
Documentation=file:docs/adr/0014-persistent-agents-supervised-by-systemd.md
# This unit must never be the process that creates the tmux server. A
# `tmux new-session` against a dead socket forks a server into whichever cgroup
# runs it, and a later restart of that unit then kills every session on the
# socket. Server lifetime belongs to the socket's keeper unit exclusively; the
# launcher enforces that in code and fails loud naming the keeper.
#
# Wants=, not Requires=: a routine restart of the keeper must not propagate a
# stop/start into every agent unit and burn their start-limit budget. After=
# still orders behind it at boot, and the guarantee that matters is enforced
# where it can be tested -- in the launcher.
Wants=network-online.target
After=network-online.target

# RestartSec x StartLimitBurst (5 x 5 = 25s) must fit inside this window, or the
# burst is unreachable and the unit restarts forever while looking rate-limited.
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
# The launcher stays in the foreground for the life of the agent and exits
# non-zero when the agent dies, which is what makes Restart= meaningful.
# ExecStart is argv-only; %i is the agent name and reaches the launcher solely
# as a path component of a config file CHROTE wrote.
ExecStart=/usr/local/lib/chrote/chrote-agent-ensure.sh --config %h/.config/chrote/agents/%i.conf
Restart=on-failure
RestartSec=5

# The tmux server and the agent inside it are deliberately NOT children of this
# unit's cgroup: the session lives on the keeper's socket and must survive this
# unit stopping. KillMode=process keeps a stop from reaping anything but the
# launcher itself.
KillMode=process

# The launcher reads one config file and drives tmux; it needs no more than this.
NoNewPrivileges=yes
PrivateTmp=no

[Install]
WantedBy=default.target
