# HTTP bind defaults. Use HOST=0.0.0.0 only behind explicit network controls.
HOST=127.0.0.1
PORT=8094
TTYD_PORT=7683
TMUX_TMPDIR=

# API authentication for headless/external API consumers.
# If set, /api/* requests except /api/health require: Authorization: Bearer <token>
# The bundled dashboard sends no Authorization header today, so enabling this
# breaks normal dashboard API calls until dashboard auth/session support exists.
# Non-API routes, including / and /terminal/, are not gated by this token.
API_AUTH_TOKEN=

# CORS allowed origins for browser API consumers.
# If not set, no CORS headers are sent, so cross-origin browser requests are rejected.
# Example: CORS_ORIGINS=https://chrote.example.com,https://localhost:5173
CORS_ORIGINS=

# Files and terminal workspace roots.
# CHROTE_ROOTS controls file access; CHROTE_WORKDIR controls new session cwd.
# Set CHROTE_ROOTS=/ only for trusted local deployments where the dashboard is
# allowed to browse every path the CHROTE service user can read/write.
CHROTE_ROOTS=
CHROTE_WORKDIR=
CHROTE_LAUNCH_SCRIPT=/usr/local/bin/terminal-launch.sh

# Optional default terminal socket override. When set, existing /api/tmux/* and
# /terminal/ use this tmux socket instead of ambient TMUX_TMPDIR.
CHROTE_DEFAULT_TMUX_SOCKET=
CHROTE_DEFAULT_TMUX_WORKDIR=

# Per-terminal-tab Unix-user launch settings. The dashboard Settings UI sends
# one of CHROTE_TERMINAL_USERS as unixUser when creating/attaching a session.
# Cross-user entries need filesystem access plus tmux server-access on the target socket.
# Example: CHROTE_TERMINAL_USERS=perttu,tavern
# Example: CHROTE_TERMINAL_USER_SOCKETS=tavern=/tmp/tmux-1001/default
# Example: CHROTE_TERMINAL_USER_WORKDIRS=perttu=/home/perttu,tavern=/home/tavern
CHROTE_TERMINAL_USERS=
CHROTE_TERMINAL_USER_SOCKETS=
CHROTE_TERMINAL_USER_WORKDIRS=

# Beads integration.
CHROTE_BD_COMMAND=bd
CHROTE_BEADS_WORKSPACES=
# Set to 0/false to show only CHROTE_BEADS_WORKSPACES plus manual project paths.
CHROTE_BEADS_AUTO_DISCOVER=
CHROTE_BV_LAUNCH_SCRIPT=/usr/local/bin/bv-launch.sh

# Agent/session observation.
CHROTE_AGENT_PREFIXES=claude-,codex,opencode,agent-

# Optional local service adapters. Keep tokens in host-owned service env files.
CHROTE_TTS_URL=http://127.0.0.1:3100
CHROTE_CONTEXT_API_URL=http://127.0.0.1:3200
CHROTE_CONTEXT_API_TOKEN=

# Formations is always-on: the Formations API, run engine, and Agents surface
# are permanent and need no enable switch. The variables below are the executor
# safety ladder; they gate execution-environment promotion (lab -> isolated
# tmux -> live socket), never feature availability. See FORMATIONS.md
# "Execution environments".

# Formations lab executor: deterministic runs with no tmux involvement.
# Configuring any lab harness takes precedence over the tmux executor.
# CHROTE_FORMATIONS_LAB_HARNESSES is a CSV of harness variant ids to accept.
CHROTE_FORMATIONS_LAB_HARNESSES=
CHROTE_FORMATIONS_LAB_CWD=
CHROTE_FORMATIONS_LAB_ROOTS=
CHROTE_FORMATIONS_LAB_OUTPUT_CAP_BYTES=

# Formations tmux executor: dispatches to live agent sessions on a tmux socket.
# SOCKET is the socket file path; sessions must already exist and be named
# SESSION_PREFIX + the persona harness variant's sessionStem. The executor
# never creates or kills sessions. Without the prod-smoke opt-in below, the
# socket, cwd, and all roots must live under the system temp directory
# (isolated dogfood socket); the live cockpit socket is refused.
CHROTE_FORMATIONS_TMUX_HARNESSES=
CHROTE_FORMATIONS_TMUX_SOCKET=
CHROTE_FORMATIONS_TMUX_CWD=
CHROTE_FORMATIONS_TMUX_ROOTS=
CHROTE_FORMATIONS_TMUX_SESSION_PREFIX=
CHROTE_FORMATIONS_TMUX_OUTPUT_CAP_BYTES=
CHROTE_FORMATIONS_TMUX_TIMEOUT_SECONDS=

# Explicit operator opt-in to run against the live tmux socket and real
# workspace roots (e.g. SOCKET=/run/user/1000/chrote-tmux/tmux-1000/default).
# Accepts: 1, true, yes, allow, allow-live, prod-smoke. All other guards
# (existing sessions, prefix match, cwd-in-roots, caps, timeouts, redaction,
# fail-loud ledger events) still apply. Leave empty everywhere except a
# deliberately promoted CHROTE service environment.
CHROTE_FORMATIONS_TMUX_PROD_SMOKE=
