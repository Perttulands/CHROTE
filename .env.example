# HTTP bind defaults. Use HOST=0.0.0.0 only behind explicit network controls.
HOST=127.0.0.1
PORT=8094
TTYD_PORT=7683

# CORS allowed origins for browser API consumers.
# If not set, no CORS headers are sent, so cross-origin browser requests are rejected.
# Example: CORS_ORIGINS=https://chrote.example.com,https://localhost:5173
CORS_ORIGINS=

# Files and terminal workspace roots.
# CHROTE_ROOTS controls file reads and mutations; CHROTE_WORKDIR controls new-session cwd.
# Keep CHROTE_ROOTS narrow. Setting CHROTE_ROOTS=/ allows CHROTE to read or
# mutate any path the service user can access if an API/resolver permits it.
# This is not an OS sandbox for tmux agents.
# Set CHROTE_ROOTS=/ only for trusted local deployments where the dashboard is
# allowed to browse every path the CHROTE service user can read/write.
CHROTE_ROOTS=
# Optional maximum request body size for file uploads, in bytes (default 64 MiB).
CHROTE_MAX_UPLOAD_BYTES=
CHROTE_WORKDIR=
CHROTE_LAUNCH_SCRIPT=/usr/local/bin/terminal-launch.sh

# Explicit ordered terminal identities and sockets. Each entry is
# unixUser=/absolute/socket; one mapping permits legacy requests without unixUser,
# while multiple mappings require an explicit unixUser.
CHROTE_TMUX_SOCKET=
# Optional per-user new-session directories. Other users use CHROTE_WORKDIR.
CHROTE_TERMINAL_USER_WORKDIRS=
# Optional tmux binary override (default: tmux).
CHROTE_TMUX_BIN=

# Terminal size guard. A browser terminal attaches before the page reports its
# viewport, so it arrives at 80x24; with tmux `window-size latest` a hidden or
# abandoned tab would then clamp a live agent's window to 80 columns. The guard
# marks such a client `ignore-size` once it has stayed at 80x24 and idle past
# CHROTE_TERMINAL_SIZE_GUARD_IDLE, and widens a session left without any sizing
# client to CHROTE_TERMINAL_UNOBSERVED_COLS x CHROTE_TERMINAL_UNOBSERVED_ROWS.
# The flag is cleared as soon as the client reports a real viewport.
# Set CHROTE_TERMINAL_SIZE_GUARD=off to disable the sweep entirely.
# Defaults: guard on, interval 1m, idle 5m, unobserved size 200x50.
CHROTE_TERMINAL_SIZE_GUARD=
CHROTE_TERMINAL_SIZE_GUARD_INTERVAL=
CHROTE_TERMINAL_SIZE_GUARD_IDLE=
CHROTE_TERMINAL_UNOBSERVED_COLS=
CHROTE_TERMINAL_UNOBSERVED_ROWS=

# Host-owned CHROTE state. The public user installer sets these under
# $XDG_STATE_HOME/chrote (or ~/.local/state/chrote).
CHROTE_SESSION_DROPS_DIR=
CHROTE_SCHEDULED_TASKS_DIR=

# Beads integration.
CHROTE_BD_COMMAND=bd
CHROTE_BEADS_WORKSPACES=
# Set to 0/false to show only CHROTE_BEADS_WORKSPACES plus manual project paths.
CHROTE_BEADS_AUTO_DISCOVER=

# Optional local service adapters. Keep tokens in host-owned service env files.
CHROTE_TTS_URL=http://127.0.0.1:3100
CHROTE_CONTEXT_API_URL=http://127.0.0.1:3200
CHROTE_CONTEXT_API_TOKEN=
