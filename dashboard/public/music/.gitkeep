# Place local MP3 files here.
#
# The current MusicPlayer track list is hard-coded in
# dashboard/src/components/MusicPlayer.tsx and expects the named MP3s in this
# directory. MP3 files are intentionally ignored by git.
#
# /srv deployment note:
# Keep the durable source copy under /srv/data/chrote/assets/music/ and copy it
# into this directory before running `npm run build` when rebuilding a fresh
# /srv/chrote checkout.
