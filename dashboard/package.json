{
  "name": "chrote-dashboard",
  "version": "2.0.0-alpha.2-dev",
  "private": true,
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node ../scripts/component-map.mjs && tsc && vite build",
    "preview": "vite preview",
    "test": "env -u NO_COLOR playwright test",
    "test:server-contract": "env -u NO_COLOR CHROTE_PLAYWRIGHT_SERVER_CONTRACT=1 playwright test tests/contract",
    "test:live": "env -u NO_COLOR CHROTE_PLAYWRIGHT_LIVE=1 playwright test tests/integration",
    "test:unit": "vitest run",
    "test:ui": "env -u NO_COLOR playwright test --ui",
    "test:headed": "env -u NO_COLOR playwright test --headed",
    "lint": "eslint ."
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^1.16.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.1",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "jsdom": "^27.4.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.59.4",
    "vite": "^8.0.13",
    "vitest": "^4.1.6"
  }
}
