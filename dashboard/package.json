{
  "name": "chrote-dashboard",
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "env -u NO_COLOR playwright test",
    "test:live": "env -u NO_COLOR CHROTE_PLAYWRIGHT_LIVE=1 playwright test tests/integration",
    "test:unit": "vitest run",
    "test:ui": "env -u NO_COLOR playwright test --ui",
    "test:headed": "env -u NO_COLOR playwright test --headed",
    "lint": "eslint ."
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.6",
    "eslint": "^10.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "jsdom": "^27.4.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.59.4",
    "vite": "^8.0.13",
    "vitest": "^4.1.6"
  }
}
