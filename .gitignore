# Environment files with secrets
.env
.env.local
.env.*.local

# Tailscale state (contains machine keys)
tailscale_state/

# Filebrowser database (contains user sessions)
filebrowser_data/

# Build artifacts
*.log

# Temporary files
tmpclaude-*
*.tmp
*:Zone.Identifier

# Node modules (rebuild from package.json)
dashboard/node_modules/

# IDE files
.vscode/
.idea/
api/node_modules/

# Go binaries (build with: cd src && go build -o chrote-server ./cmd/server)
src/chrote-server
src/server.exe
src/arena-server
src/server
chrote-server
chrote-server-integ
*.exe

# Vite cache
dashboard/.vite/
dashboard/dist/
dashboard/coverage/
dashboard/playwright-report/
dashboard/public/music/*.mp3

README.md.backup

# Nested repo clones (reference only, not part of chrote)
/components/
/integrations/

# Instance-specific state (Polis or any deployment)
# Systemd units live outside the repo (~/.config/systemd/user/)
# The following are created at runtime, not tracked:
*.sqlite
*.db
*.db-wal
*.db-shm
# Beads workspace: track durable issue data + identity with the code,
# ignore the local Dolt database and runtime files (see .beads/.gitignore).
.beads/*
!.beads/issues.jsonl
!.beads/metadata.json
!.beads/config.yaml
!.beads/README.md
!.beads/WORKSPACE.md
!.beads/.gitignore
src/internal/dashboard/dist/
src/internal/dashboard/assets/
src/internal/dashboard/music/
src/internal/dashboard/*.html
src/internal/dashboard/*.png

# Claude Code config
.claude/

# Test results (generated)
**/test-results/

# Playwright report data (generated)
dashboard/playwright-report/data/

# Beads / Dolt files (added by bd init)
.dolt/
.beads-credential-key

# Beads / Dolt files (added by bd init)
.beads/proxieddb/
